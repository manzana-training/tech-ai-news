# ============================================================
# Tech AI News — environment template
# ============================================================
# Copy to `.env` and fill with your own values.
# Required only if you want to run the live digest pipeline
# (news_digest.py). The dashboard build (analysis/build_dashboard.py)
# does NOT need any of these — it reads the static JSONL history.
# ============================================================

# Anthropic Claude API key — used for daily curation
ANTHROPIC_API_KEY=

# Telegram bot token — message delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How many hours back to scan in RSS feeds
LOOKBACK_HOURS=24

# Logging
LOG_LEVEL=INFO

# Claude model (optional override)
# CLAUDE_MODEL=claude-haiku-4-5-20251001
